# Value matching stock fuxi OS3.0.307.0.WMCCNXM odm/etc/build.prop for the
# Dolby Vision camera path (MIUI Camera + libmediaimpl/libmisurfaceflinger).
ro.vendor.display.dolbyvision.support=true
ro.vendor.mi_sf.gallery_p3_dolby_opt=true

# Enable Dolby Vision video recording / capture in the media and camera stack.
debug.config.media.video.dolby_vision_suports=true
debug.config.media.video.dolby_capture_supports=true
